{
  "name": "kaiju",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "cd packages/web && bunx playwright test",
    "dev:web": "cd packages/web && bun run dev",
    "dev:cli": "bun run packages/cli/src/index.ts",
    "db:generate": "cd packages/core && bunx drizzle-kit generate",
    "db:migrate": "cd packages/core && bunx drizzle-kit migrate",
    "db:studio": "cd packages/core && bunx drizzle-kit studio"
  },
  "devDependencies": {
    "@playwright/test": "~1.58.0",
    "@types/bun": "~1.3.10",
    "drizzle-kit": "~0.31.0",
    "lefthook": "~2.1.0",
    "oxfmt": "~0.36.0",
    "oxlint": "~1.51.0",
    "shadcn": "^4.0.0",
    "typescript": "~5.7.0",
    "vitest": "~4.0.18"
  }
}
